<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{{#if title}}{{title}} — Bloom{{else}}Bloom{{/if}}</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
  <script>
    window.applyTheme = function (theme, save) {
      var customThemes = ['bloom', 'meadow'];
      var resolved;

      if (customThemes.indexOf(theme) !== -1) {
        resolved = theme;
      } else if (theme === 'dark' || (theme === 'system' && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
        resolved = 'dark';
      } else {
        resolved = 'light';
      }

      document.documentElement.setAttribute('data-theme', resolved);
      if (save) localStorage.setItem('bloom-theme', theme);
    };

    window.applyTheme(localStorage.getItem('bloom-theme') || 'system', false);
  </script>
  <link rel="stylesheet" href="/resources/css/style.css" />
</head>
<body>
  <div class="phone-shell">
    <main class="page-content">
      {{{body}}}
    </main>
    {{#unless hideNav}}
      {{> footer}}
    {{/unless}}
  </div>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/resources/js/script.js"></script>
</body>
</html>