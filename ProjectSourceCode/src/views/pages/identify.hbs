{{!-- src/views/pages/identify.hbs — REPLACE the GitHub/local version with this.
     Same upload form as before (POST /identify, JPG/PNG + organ),
     plus the result popup: plant info + Wikipedia description, with a
     "Save to Bloomdex" button that POSTs to /collection.
     POST /collection is already in index.js — it saves the plant,
     gives +10 points only for a new species, and awards badges. --}}
<h2>Identify a plant</h2>

<form action="/identify" method="POST" enctype="multipart/form-data">
  <div class="mb-3">
    <label for="image" class="form-label">Photo (JPG or PNG)</label>
    <input type="file" class="form-control" id="image" name="image" accept="image/jpeg,image/png" required />
  </div>
  <div class="mb-3">
    <label for="organ" class="form-label">Plant part (optional)</label>
    <select class="form-select" id="organ" name="organ">
      <option value="auto" selected>Auto</option>
      <option value="leaf">Leaf</option>
      <option value="flower">Flower</option>
      <option value="fruit">Fruit</option>
      <option value="bark">Bark</option>
    </select>
  </div>
  <button type="submit" class="btn btn-success">Identify</button>
</form>

{{#if message}}
  <div class="alert alert-danger mt-3">{{message}}</div>
{{/if}}

{{#if bestMatch}}
  <div class="card mt-4">
    {{#if imagePath}}
      <img src="{{imagePath}}" class="card-img-top" alt="{{commonName}}" />
    {{/if}}
    <div class="card-body">
      <h3>{{commonName}}</h3>
      <p><em>{{scientificName}}</em></p>
      <p>Confidence: {{confidencePercent}}%</p>
      {{#if family}}<p>Family: {{family}}</p>{{/if}}
      {{#if predictedOrgan}}<p>Plant part seen: {{predictedOrgan}}</p>{{/if}}
      {{#if description}}<p>{{description}}</p>{{/if}}
      {{#if remainingIdentificationRequests}}
        <p class="text-muted">Requests left: {{remainingIdentificationRequests}}</p>
      {{/if}}

      {{!-- Save it: POST /collection (already in index.js). --}}
      <form action="/collection" method="POST">
        <input type="hidden" name="scientific_name" value="{{scientificName}}" />
        <input type="hidden" name="common_name" value="{{commonName}}" />
        <input type="hidden" name="image_path" value="{{imagePath}}" />
        <input type="hidden" name="location" value="{{location}}" />
        <button type="submit" class="btn btn-success">Save to Bloomdex</button>
      </form>
    </div>
  </div>
  {{#if alternatives}}
    <h4 class="mt-3">Other possibilities</h4>
    <ul>
      {{#each alternatives}}
        <li>{{commonName}} ({{scientificName}}) — {{score}}</li>
      {{/each}}
    </ul>
  {{/if}}
{{/if}}
