{{!-- Identify a plant. Result (bear bubble + result card) on top, upload form at the bottom. --}}
<style>
  /* Uses the site's design tokens (--surface, --text, --muted, --border, --green...),
     so light and dark mode follow [data-theme="dark"] automatically.
     The Upload Image button is styled by the site's own .upload-image-btn rules. */
  .identify-page { max-width: 920px; margin: 0 auto; padding: 0 0 2rem; color: var(--text); }
  .identify-page h2 { margin-bottom: 1rem; }
  .identify-page .form-label { color: var(--text); }
  .identify-page .text-muted { color: var(--muted) !important; }

  /* ---------- Upload panel ---------- */
  .upload-panel {
    display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem; align-items: start;
    background: var(--surface); border: 1px solid var(--border);
    border-radius: var(--radius); box-shadow: var(--shadow-sm); padding: 1.1rem;
  }
  .upload-fields { display: flex; flex-direction: column; gap: 1rem; }
  .upload-row { display: flex; align-items: center; gap: .75rem; flex-wrap: wrap; }
  .upload-row:focus-within .upload-image-btn { outline: 3px solid rgba(74, 157, 107, 0.45); outline-offset: 3px; }
  #upload-filename { color: var(--muted); font-size: .9rem; overflow-wrap: anywhere; }

  .preview-box {
    height: 220px; border: 2px dashed var(--border); border-radius: var(--radius);
    background: var(--green-tint); color: var(--muted); text-align: center; padding: .5rem;
    display: flex; align-items: center; justify-content: center; overflow: hidden;
  }
  .preview-box img {
    width: 100%; height: 100%; max-height: none; margin: 0; padding: 0;
    object-fit: cover; border: 0; border-radius: calc(var(--radius) - .2rem); box-shadow: none;
  }

  /* ---------- Bloom Bear + speech bubble ---------- */
  .bear-row { display: flex; align-items: flex-end; gap: 1.25rem; margin: 1.75rem 0 1.25rem; }
  .bear-row img { width: 130px; height: auto; flex-shrink: 0; }
  .bubble {
    position: relative; background: var(--surface); color: var(--text);
    border: 3px solid var(--green); border-radius: 20px;
    padding: 1rem 1.25rem; font-size: 1.1rem; line-height: 1.4; margin-bottom: 1.5rem;
  }
  .bubble::before {
    content: ""; position: absolute; left: -19px; bottom: 22px;
    border: 8px solid transparent; border-right-color: var(--green);
  }
  .bubble::after {
    content: ""; position: absolute; left: -12px; bottom: 24px;
    border: 6px solid transparent; border-right-color: var(--surface);
  }

  /* ---------- Result card ---------- */
  .result-card {
    display: grid; grid-template-columns: 300px 1fr; gap: 1.5rem;
    background: var(--surface); border: 1px solid var(--border);
    border-radius: var(--radius); box-shadow: var(--shadow-sm); padding: 1.1rem;
  }
  .result-photo {
    width: 100%; height: 300px; object-fit: cover;
    border-radius: calc(var(--radius) - .2rem);
  }
  .result-details h3 { margin: 0; }
  .result-details .sci { font-style: italic; color: var(--muted); margin: .25rem 0 1rem; }
  .chips { display: flex; flex-wrap: wrap; gap: .5rem; margin-bottom: 1rem; }
  .chip { background: var(--green-tint); color: var(--text); border: 1px solid var(--border); padding: .2rem .7rem; border-radius: 999px; font-size: .9rem; }
  .confidence-bar { background: var(--green-tint); border: 1px solid var(--border); border-radius: 999px; height: 10px; overflow: hidden; margin-bottom: 1rem; }
  .confidence-fill { background: var(--green); height: 100%; }
  .result-details .description { margin-bottom: 1rem; }
  .save-form { margin-top: 1rem; }

  .alts { margin-top: 1.5rem; }
  .alts ul { padding-left: 1.1rem; color: var(--muted); }

  @media (max-width: 720px) {
    .upload-panel, .result-card { grid-template-columns: 1fr; }
    .result-photo { height: 240px; }
    .bear-row img { width: 100px; }
  }
</style>

<div class="identify-page">
  <h2>Identify a plant</h2>

  {{#if bestMatch}}
    <div class="bear-row">
      <img src="../assets/avatar/BloomBear-Talking.png" alt="Bloom Bear talking" />
      <div class="bubble">
        Wow! A {{#if commonName}}{{commonName}}{{else}}{{scientificName}}{{/if}}!
        Come to the Bloomdex to learn more!
      </div>
    </div>

    <div class="result-card">
      {{#if imagePath}}
        <img src="{{imagePath}}" class="result-photo" alt="{{#if commonName}}{{commonName}}{{else}}{{scientificName}}{{/if}}" />
      {{/if}}

      <div class="result-details">
        <h3>{{#if commonName}}{{commonName}}{{else}}{{scientificName}}{{/if}}</h3>
        <p class="sci">{{scientificName}}</p>

        <div class="chips">
          {{#if family}}<span class="chip">Family: {{family}}</span>{{/if}}
          {{#if predictedOrgan}}<span class="chip">Plant part seen: {{predictedOrgan}}</span>{{/if}}
        </div>

        <p><strong>Confidence: {{confidencePercent}}%</strong></p>
        <div class="confidence-bar" role="presentation">
          <div class="confidence-fill" style="width: {{confidencePercent}}%"></div>
        </div>

        {{#if description}}<p class="description">{{description}}</p>{{/if}}

        {{!-- Save it: POST /collection (already in index.js). --}}
        <form action="/collection" method="POST" class="save-form">
          <input type="hidden" name="scientific_name" value="{{scientificName}}" />
          <input type="hidden" name="common_name" value="{{commonName}}" />
          <input type="hidden" name="image_path" value="{{imagePath}}" />
          <input type="hidden" name="organ" value="{{predictedOrgan}}" />
          <input type="hidden" name="location" value="{{location}}" />
          <button type="submit" class="btn btn-success">Save to Bloomdex</button>
        </form>

        {{#if remainingIdentificationRequests}}
          <p class="text-muted mt-3 mb-0">Requests left: {{remainingIdentificationRequests}}</p>
        {{/if}}
      </div>
    </div>

    {{#if alternatives}}
      <div class="alts">
        <h4>Other possibilities</h4>
        <ul>
          {{#each alternatives}}
            <li>{{#if commonName}}{{commonName}} ({{scientificName}}){{else}}{{scientificName}}{{/if}} — {{score}}</li>
          {{/each}}
        </ul>
      </div>
    {{/if}}
  {{/if}}

  {{!-- Upload block, at the bottom --}}
  <form action="/identify" method="POST" enctype="multipart/form-data" style="margin-top: 2rem;">
    <div class="upload-panel">
      <div class="upload-fields">
        <div class="upload-row">
          <label for="image" class="upload-image-btn">Upload Image</label>
          <input type="file" id="image" name="image" accept="image/jpeg,image/png" required style="position:absolute; width:1px; height:1px; opacity:0; overflow:hidden;" />
          <span id="upload-filename">JPG or PNG, up to 10 MB</span>
        </div>

        <div>
          <label for="organ" class="form-label">Plant part (optional)</label>
          <select class="form-select" id="organ" name="organ">
            <option value="auto" selected>Auto</option>
            <option value="leaf">Leaf</option>
            <option value="flower">Flower</option>
            <option value="fruit">Fruit</option>
            <option value="bark">Bark</option>
          </select>
        </div>

        <button type="submit" class="btn btn-success">Identify</button>
      </div>

      <div id="preview-wrap" class="preview-box">Your photo will show up here</div>
    </div>
  </form>

  {{#if message}}
    <div class="alert alert-danger mt-3">{{message}}</div>
  {{/if}}
</div>

<script>
  (function () {
    var input = document.getElementById('image');
    var previewWrap = document.getElementById('preview-wrap');
    var filename = document.getElementById('upload-filename');
    input.addEventListener('change', function () {
      var file = input.files[0];
      if (!file) return;
      filename.textContent = file.name;
      var reader = new FileReader();
      reader.onload = function (event) {
        previewWrap.innerHTML = '';
        var img = document.createElement('img');
        img.alt = 'Uploaded plant preview';
        img.src = event.target.result;
        previewWrap.appendChild(img);
      };
      reader.readAsDataURL(file);
    });
  })();
</script>