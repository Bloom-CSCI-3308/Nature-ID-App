{{!-- src/views/pages/collection.hbs
     The Bloomdex. GET /collection renders this (see INDEX_EDITS.md Edit 3).
     Expects: plants (one row per species, with id, commonName,
     scientificName, timesFound, lastFound, rarity, icon),
     totalSpecies, totalFinds, user.
     Cards show ONLY the icon. Saved photos (image) are never displayed. --}}
<div class="collection-page">
  <h2>Your Bloomdex</h2>

  <p class="text-muted">
    {{totalSpecies}} species &middot; {{totalFinds}} {{plural totalFinds "plant" "plants"}} found
  </p>

  {{#if message}}
    <div class="alert alert-danger mt-3">{{message}}</div>
  {{/if}}

  <div class="plant-grid">
    {{#each plants}}
      <a href="/plants/{{id}}" class="plant-card">
        {{#if icon}}
          <img src="{{icon}}" alt="{{commonName}}" />
        {{else}}
          <div class="plant-thumb">🌱</div>
        {{/if}}
        <span class="plant-name">{{commonName}}</span>
        {{#if rarity}}<span class="badge bg-warning text-dark">{{rarity}}</span>{{/if}}
        <span class="text-muted"><em>{{scientificName}}</em></span>
        <span class="plant-count">Found {{timesFound}} {{plural timesFound "time" "times"}}</span>
      </a>
    {{else}}
      <p>No plants yet. <a href="/identify">Identify your first plant</a>.</p>
    {{/each}}
  </div>

</div>
