<div class="login-page text-center">
  <div class="logo-circle">🌱</div>
  <h1 class="logo-text">Bloom</h1>
  <h2 class="h5 mb-3">Choose a new password</h2>

  {{#if message}}
    <div class="alert alert-info">{{message}}</div>
  {{/if}}

  <form action="/reset-password" method="POST" class="login-form">
    <input type="hidden" name="token" value="{{token}}" />
    <div class="mb-3 text-start">
      <label for="password" class="form-label">🔒 New password</label>
      <input type="password" class="form-control" id="password" name="password" placeholder="8–72 characters" minlength="8" maxlength="72" required />
    </div>
    <div class="mb-3 text-start">
      <label for="confirm_password" class="form-label">🔒 Confirm new password</label>
      <input type="password" class="form-control" id="confirm_password" name="confirm_password" placeholder="Type it again" required />
    </div>
    <button type="submit" class="btn btn-success w-100 btn-lg">Reset password</button>
  </form>
  <p class="mt-3 small"><a href="/login">Back to log in</a></p>
</div>
