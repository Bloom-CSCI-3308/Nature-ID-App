<div class="login-page text-center">
  <div class="logo-circle">🌱</div>
  <h1 class="logo-text">Bloom</h1>
  <h2 class="h5 mb-3">Forgot your password?</h2>

  {{#if message}}
    <div class="alert alert-info">{{message}}</div>
  {{/if}}

  <form action="/forgot-password" method="POST" class="login-form">
    <div class="mb-3 text-start">
      <label for="account" class="form-label">👤 Username or recovery email</label>
      <input type="text" class="form-control" id="account" name="account" placeholder="Username or email" value="{{account}}" required />
      <div class="form-text">We'll email a reset link to the recovery email on your account.</div>
    </div>
    <button type="submit" class="btn btn-success w-100 btn-lg">Send reset link</button>
  </form>
  <p class="mt-3 small">Remembered it? <a href="/login">Log in</a></p>
</div>
