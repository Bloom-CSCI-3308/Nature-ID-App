<div class="rewards-page">
  <h2>Rewards</h2>

  {{#if message}}
    <div class="alert alert-danger" role="alert">{{message}}</div>
  {{/if}}

  <p>
    <strong>{{points}}</strong> points ·
    <strong>{{plantCount}}</strong> plants found
  </p>

  {{#if nextBadge}}
    <p>
      Next badge:
      {{#if nextBadge.image}}
        <img src="{{nextBadge.image}}" class="badge-img badge-img-small" alt="{{nextBadge.name}}" />
      {{/if}}
      <strong>{{nextBadge.name}}</strong>
      ({{plantCount}} / {{nextBadge.plantsRequired}} plants)
    </p>
  {{/if}}

  <ul class="list-group">
    {{#each badges}}
      <li class="list-group-item {{#unless earned}}text-muted{{/unless}}">
        {{#if image}}
          <img src="{{image}}" class="badge-img {{#unless earned}}locked{{/unless}}" alt="{{name}}" />
        {{else}}
          <span aria-hidden="true">{{#if earned}}🏅{{else}}🔒{{/if}}</span>
        {{/if}}
        <strong>{{name}}</strong> — {{description}}
        {{#if earned}}
          <span class="small">(earned {{dateEarned}})</span>
        {{else}}
          <span class="small">(locked: find {{plantsRequired}} plants)</span>
        {{/if}}
      </li>
    {{/each}}
  </ul>
</div>
