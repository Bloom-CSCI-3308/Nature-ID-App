<div class="settings-page">
  <header class="top-bar">
    <a href="javascript:history.back()" class="back-link" aria-label="Back">←</a>
    <h2 class="settings-title">Appearance</h2>
  </header>

  <div class="settings-list">
    <label class="settings-item">
      <input type="radio" name="theme" value="light" checked/> Light
    </label>
    <label class="settings-item">
      <input type="radio" name="theme" value="dark" /> Dark
    </label>
    <label class="settings-item">
      <input type="radio" name="theme" value="bloom" /> Bloom
    </label>
    <label class="settings-item">
      <input type="radio" name="theme" value="system" /> System
    </label>
  </div>
  <p class="text-muted">System follows your phone's light / dark setting.</p>
</div>
